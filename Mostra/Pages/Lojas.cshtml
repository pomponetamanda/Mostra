﻿
@page
@model IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Império Feminino</title>
    <link rel="stylesheet" href="/css/lojas.css" />
</head>
<body>
    
    <nav class="navbar navbar-expand-lg navbar-light full-width-navbar">

        <a href="/Index">
            <img src="~/imagens/logo - Cópia.png" alt="Logo">
        </a>

        <div class="nav-links">
            <a href="/Index">Home</a>
            <a href="/Privacy">Comunidade</a>
            <a href="/Lojas">Lojas</a>

        </div>

        <div class="search-bar">
            <input type="text" placeholder="Insira sua busca">
            <button><i class="fas fa-search"></i></button>
        </div>



        <a href="/Login1">
            <button class="botaoH" type="button">Login</button>
        </a>
    </nav>

    <div class="lojas">

        <section class="gallery">
            <h2>Categorias</h2>

            <div class="gallery-row">

                <div>
                    <a href="/Vestuario">
                        <img src="~/imagens/roupa.jpg" alt="foto" />
                    </a>
                    <p>Vestuário</p>
                </div>
            

                <div>
                    <img src="~/imagens/belezaa.jpg" alt="foto" class="loja-ajuste" />
                    <p>Beleza</p>
                </div>

                <div>
                    <img src="~/imagens/doce.jpg" alt="foto" />
                    <p>Doces</p>
                </div>

                <div>
                    <a href="/calcados">
                        <img src="~/imagens/shoess.jpg" alt="foto" />
                    </a>
                    
                    <p>Calçado</p>
                </div>

                <div>
                    <img src="~/imagens/joias.jpg" alt="foto" />
                    <p>Jóias</p>
                </div>

                <div>
                    <img src="~/imagens/restaurante2.jpg" alt="foto" class="loja-ajuste"/>
                    <p>Restaurantes</p>
                </div>
            </div>
        </section>
    </div>

</body>

</html> 