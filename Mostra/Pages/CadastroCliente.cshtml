@page
@model Mostra.Pages.CadastroClienteModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Império Feminino</title>
    <link rel="stylesheet" href="/css/cadastroempresa.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light full-width-navbar">

        <a href="/Index">
            <img src="~/imagens/logo - Cópia.png" alt="Logo">
        </a>

        <div class="nav-links">
            <a href="/Index">Home</a>
            <a href="/Privacy">Comunidade</a>
            <a href="/Lojas">Lojas</a>

        </div>

        <div class="search-bar">
            <input type="text" placeholder="Insira sua busca">
            <button><i class="fas fa-search"></i></button>
        </div>



        <a href="/Login1">
            <button class="botaoH" type="button">Login</button>
        </a>
    </nav>
    <h2>Cadastro de Cliente</h2>
    <form method="post">
        <label for="nome">Noma:</label>
        <input type="text" name="nome" required /><br />

        <label for="email">Email:</label>
        <input type="text" name="email" required /><br />

        <label for="cpf">CPF:</label>
        <input type="number" name="cpf" required /><br />

        <label for="telefone">Telefone:</label>
        <input type="number" name="telefone" required /><br />

        <label for="endereco">Endereço:</label>
        <input type="number" name="endereco" required /><br />

        <label for="senha">Senha:</label>
        <input type="number" name="senha" required /><br />

        <button type="submit">Cadastrar</button>
    </form>

</body>

</html>