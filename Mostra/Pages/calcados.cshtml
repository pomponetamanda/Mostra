@page
@model IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Calçados</title>
    <link rel="stylesheet" href="/css/vestuario.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light full-width-navbar">

        <a href="/Index">
            <img src="~/imagens/logo - Cópia.png" alt="Logo">
        </a>

        <div class="nav-links">
            <a href="/Index">Home</a>
            <a href="/Privacy">Comunidade</a>
            <a href="/Lojas">Lojas</a>

        </div>

        <div class="search-bar">
            <input type="text" placeholder="Insira sua busca">
            <button><i class="fas fa-search"></i></button>
        </div>



        <a href="/Login1">
            <button class="botaoH" type="button">Login</button>
        </a>
    </nav>

    <div class="banner">
        <img src="~/imagens/bannerspatos.jpg" alt="...">
    </div>
    

    <br />
    <br />
    <h3>Navegue pelas categorias</h3>

    <div class="container-categorias">
        <form class="cat">
            <div class="categoria">
                <a href="/">
                    <img src="~/imagens/iconsalto.jpg" class="womanc" alt="...">
                </a>
                <p>Feminino</p>
            </div>

            <div class="categoria">
                <a href="/">
                    <img src="~/imagens/iconsapato.jpg" class="womanc" alt="...">
                </a>
                <p>Masculino</p>
            </div>

            <div class="categoria">
                <a href="/">
                    <img src="~/imagens/iconbebe.jpg" class="womanc" alt="...">
                </a>
                <p>Infantil</p>
            </div>

        </form>
    </div>
    <br />
    <br />

    <div class="container">
        <h3>Novas lojas para você!</h3>
        <div class="patrocinadores">


            <div class="patrocinador">
                <img src="~/imagens/amelia.jpg" alt="Patrocinador 1">
                <p>Amelia</p>
            </div>


            <div class="patrocinador">
                <a href="/PeAmostrado">
                    <img src="~/imagens/peamostrado.jpg" alt="Patrocinador 2">
                </a>
                <p>Pé Amostrado</p>
            </div>


            <div class="patrocinador">
                <img src="~/imagens/uzze.jpg" alt="Patrocinador 3">
                <p>Muzze Calçados</p>
            </div>


            <div class="patrocinador">
                <img src="~/imagens/planetshoes.jpg" alt="Patrocinador 4">
                <p>Planet Shoes</p>
            </div>
        </div>
    </div>
    <br />
    <br />

    <h3>Em alta</h3>
    <section class="marketplace-section">
        <div class="itens-marketplace">

            <div class="item">
                <img src="~/imagens/sapatilhafem.png" alt="Produto 1">
                <img src="~/imagens/maheart.png" alt="heart" class="heart-icon">
                <p class="tituloItem">Sandália Mary Jane</p>
                <h3>R$ 70,00</h3>
            </div>

            <div class="item">
                <a href="/produto2">
                    <img src="~/imagens/sapato1.png" alt="Produto 2">
                </a>
                <img src="~/imagens/maheart.png" alt="heart" class="heart-icon">
                <p class="tituloItem">Gladiadora Amostrada</p>
                <h3>R$ 109,00</h3>
            </div>

            <div class="item">
                <img src="~/imagens/peeptoe.png" alt="Produto 3">
                <img src="~/imagens/maheart.png" alt="heart" class="heart-icon">
                <p class="tituloItem">Sandália Salto Alto Com Tiras</p>
                <h3>R$ 90,00</h3>
            </div>

            <div class="item">
                <img src="~/imagens/scarpin.png" alt="Produto 1">
                <img src="~/imagens/maheart.png" alt="heart" class="heart-icon">
                <p class="tituloItem">Sapatilha Com Salto Branco e Preto</p>
                <h3>R$ 90,00</h3>
            </div>

            <div class="item">
                <img src="~/imagens/scarpin2.png" alt="Produto 2">
                <img src="~/imagens/maheart.png" alt="heart" class="heart-icon">
                <p class="tituloItem">Sapato Fechado com Salto</p>
                <h3>R$ 85,00</h3>
            </div>

            <div class="item">
                <img src="~/imagens/tornozeleira.png" alt="Produto 3">
                <img src="~/imagens/maheart.png" alt="heart" class="heart-icon">
                <p class="tituloItem">Salto Alto Preto </p>
                <h3>R$ 200,00</h3>
            </div>
        </div>
    </section>

</body>
</html>